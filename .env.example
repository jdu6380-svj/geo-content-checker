OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4-flash

# Optional cost estimate rates. Keep provider pricing outside source code.
MODEL_INPUT_COST_USD_PER_MILLION_TOKENS=
MODEL_OUTPUT_COST_USD_PER_MILLION_TOKENS=

# Analysis admission and signed 30-minute sessions.
RATE_LIMIT_SALT=
ANALYSIS_TOKEN_SECRET=
BETA_EVENT_HMAC_SECRET=

# Upstash Redis REST credentials. Local development falls back to memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Only explicit Upstash quota exhaustion may use bounded in-memory limiting.
REDIS_QUOTA_FAIL_OPEN=false

# Public Beta feedback and support.
NEXT_PUBLIC_FEEDBACK_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Sentry. Request bodies and identity headers are scrubbed before sending.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_TRACES_SAMPLE_RATE=0.1
