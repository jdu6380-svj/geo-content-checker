OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4-flash

# Optional cost estimate rates. Keep provider pricing outside source code.
MODEL_INPUT_COST_USD_PER_MILLION_TOKENS=
MODEL_OUTPUT_COST_USD_PER_MILLION_TOKENS=

# Shared model-call budget. Preview B.2 uses 240 calls per hour.
MODEL_CALL_BUDGET_PER_HOUR=180

# Analysis admission and signed 30-minute sessions.
RATE_LIMIT_SALT=
ANALYSIS_TOKEN_SECRET=
BETA_EVENT_HMAC_SECRET=

# Upstash Redis REST credentials. Local development falls back to memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Only explicit Upstash quota exhaustion may use bounded in-memory limiting.
REDIS_QUOTA_FAIL_OPEN=false

# Public Beta feedback and support.
NEXT_PUBLIC_FEEDBACK_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Sentry. Request bodies and identity headers are scrubbed before sending.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Commercial identity and persistence. No workspace identity is accepted from client input.
NEXT_PUBLIC_APP_URL=https://staging.example.com
COMMERCIAL_AUTH_ADAPTER=clerk
COMMERCIAL_DATA_ADAPTER=neon
COMMERCIAL_WORKSPACE_BOOTSTRAP=clerk-org
# Optional legacy/operator mapping for existing workspaces. New Clerk organizations use a deterministic server-side ID.
COMMERCIAL_CLERK_ORG_WORKSPACE_MAP=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
DATABASE_URL=
COMMERCIAL_PAYMENT_EVENT_STORE=neon
COMMERCIAL_STORAGE_ADAPTER=vercel-blob
BLOB_READ_WRITE_TOKEN=

# Commercial payments. Values belong in the controlled environment, never source control.
COMMERCIAL_PAYMENT_PROVIDER=alipay
NEXT_PUBLIC_COMMERCIAL_PAYMENT_PROVIDER=alipay
# Set the public flag to true for the invite-only Evidra portfolio Beta UI.
NEXT_PUBLIC_EVIDRA_BETA_MODE=false
# Optional local portfolio mode. Vercel Preview enables it automatically;
# Vercel Production always keeps authentication enabled.
NEXT_PUBLIC_EVIDRA_INTERVIEW_MODE=false
# Server-only comma-separated operator subject ids. Keep empty until operators are approved.
EVIDRA_BETA_OPERATOR_SUBJECTS=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_NOTIFY_URL=https://staging.example.com/api/alipay/notify
ALIPAY_RETURN_URL=https://staging.example.com/api/alipay/return
ALIPAY_PLAN_AMOUNT_MAP=new_user=9.90,growth=29.90,team=99.00,agency=299.00
ALIPAY_PLAN_RUN_LIMIT_MAP=new_user=2,growth=8,team=35,agency=120
# Required before exposing the new-user package: enforce one successful purchase per workspace in the persistent order/entitlement service.
ALIPAY_FIRST_PURCHASE_PLAN=new_user

# Commercial executor and optional safe run telemetry. Production requires an explicit provider-backed executor.
COMMERCIAL_EXECUTOR=openai-compatible
COMMERCIAL_TELEMETRY=

# Stripe compatibility variables must remain unset while Alipay is selected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_ALLOWLIST=
STRIPE_PRICE_ID_RUN_LIMITS=
STRIPE_PLAN_PRICE_MAP=
