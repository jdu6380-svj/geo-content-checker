{
  "name": "geo-content-checker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.x"
  },
  "scripts": {
    "dev": "EVIDRA_DEV_MODEL=false UPSTASH_REDIS_REST_URL= UPSTASH_REDIS_REST_TOKEN= next dev --turbopack",
    "dev:model": "EVIDRA_DEV_MODEL=true next dev --turbopack",
    "dev:webpack": "EVIDRA_DEV_MODEL=false UPSTASH_REDIS_REST_URL= UPSTASH_REDIS_REST_TOKEN= next dev",
    "prebuild": "node --env-file-if-exists=.env.local scripts/check-release-config.mjs",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "typecheck": "npm run typecheck:app && npm run typecheck:scripts",
    "check": "npm run typecheck && npm run lint",
    "setup:env": "node scripts/setup-local-env.mjs",
    "security:unit": "node --experimental-strip-types scripts/security-unit.ts",
    "commercial:migrate": "node scripts/migrate-commercial.mjs",
    "staging:check": "node scripts/check-staging-config.mjs",
    "staging:check:test": "node --test scripts/check-staging-config.test.mjs",
    "staging:smoke": "node scripts/staging-smoke.mjs",
    "staging:smoke:test": "node --test scripts/staging-smoke.test.mjs",
    "blackbox": "node scripts/blackbox.mjs",
    "blackbox:legacy-migration": "node scripts/blackbox.mjs",
    "metrics:beta": "node scripts/beta-metrics-report.mjs",
    "model:validate": "node scripts/model-validation.mjs",
    "b1:validate": "node --experimental-strip-types scripts/b1-technical-validation.ts",
    "b1.5:calibrate": "node --experimental-strip-types scripts/b1.5-model-calibration.ts",
    "release:check": "REQUIRE_RELEASE_CONFIG=true node --env-file-if-exists=.env.local scripts/check-release-config.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.6",
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/nextjs": "^10.66.0",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.24.0",
    "next": "15.5.20",
    "radix-ui": "^1.6.2",
    "react": "^19.1.4",
    "react-dom": "^19.1.4",
    "stripe": "^22.6.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "15.5.20",
    "jsdom": "^28.0.0",
    "postcss": "8.5.18",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "8.5.18"
  }
}
